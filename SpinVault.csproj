<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>ColecaoMidias</RootNamespace>
    <AssemblyName>SpinVault</AssemblyName>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <Product>SpinVault</Product>
    <AssemblyTitle>SpinVault - Coleção de Mídias</AssemblyTitle>
    <Description>Catálogo de CDs, discos de vinil e fitas cassete</Description>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Repositório consultado pelo aviso de atualização ("dono/repo"). O GitHub Actions preenche sozinho. -->
    <UpdateRepository></UpdateRepository>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF não importa estes namespaces automaticamente -->
    <Using Include="System.IO" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Tasks" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- Grava o repositório no programa, para ele saber onde procurar versões novas -->
    <AssemblyMetadata Include="UpdateRepository" Value="$(UpdateRepository)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ícone e logotipo embutidos no programa -->
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\logo-128.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
  </ItemGroup>

</Project>
