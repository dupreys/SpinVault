<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="SpinVaultMobile.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:SpinVaultMobile"
       Shell.FlyoutBehavior="Disabled"
       Shell.BackgroundColor="{StaticResource Bg}"
       Shell.ForegroundColor="{StaticResource Accent}"
       Shell.TitleColor="{StaticResource TextPrimary}"
       Shell.TabBarBackgroundColor="{StaticResource Surface}"
       Shell.TabBarForegroundColor="{StaticResource Accent}"
       Shell.TabBarTitleColor="{StaticResource Accent}"
       Shell.TabBarUnselectedColor="{StaticResource TextMuted}">

    <TabBar>
        <ShellContent Title="{local:Tr 'Coleção'}" Route="collection" ContentTemplate="{DataTemplate local:CollectionPage}">
            <ShellContent.Icon>
                <FontImageSource Glyph="♫" Size="22" Color="{StaticResource TextMuted}" />
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent Title="{local:Tr 'Desejos'}" Route="wishlist" ContentTemplate="{DataTemplate local:WishlistPage}">
            <ShellContent.Icon>
                <FontImageSource Glyph="♡" Size="22" Color="{StaticResource TextMuted}" />
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent Title="{local:Tr 'Resumo'}" Route="summary" ContentTemplate="{DataTemplate local:SummaryPage}">
            <ShellContent.Icon>
                <FontImageSource Glyph="◔" Size="22" Color="{StaticResource TextMuted}" />
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent Title="{local:Tr 'Configurações'}" Route="settings" ContentTemplate="{DataTemplate local:SettingsPage}">
            <ShellContent.Icon>
                <FontImageSource Glyph="⚙" Size="22" Color="{StaticResource TextMuted}" />
            </ShellContent.Icon>
        </ShellContent>
    </TabBar>
</Shell>
