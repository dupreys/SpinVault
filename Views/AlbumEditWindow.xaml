<Window x:Class="ColecaoMidias.Views.AlbumEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ColecaoMidias.Services"
        Title="{Binding WindowTitle}"
        Width="800" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        AllowDrop="True" Drop="OnDrop"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}" FontSize="13">
    <DockPanel Margin="28" LastChildFill="True">
        <!-- Rodapé fixo: erro e botões ficam sempre visíveis, mesmo com a janela rolando -->
        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" MinHeight="18"
                       Foreground="{DynamicResource ErrorBrush}" Text="{Binding ErrorMessage}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="{l:Tr 'Cancelar'}" Style="{StaticResource GhostButton}" Margin="0,0,8,0" IsCancel="True" />
                <Button Content="{l:Tr 'Salvar'}" Style="{StaticResource PrimaryButton}" Padding="26,9" IsDefault="True"
                        Command="{Binding SaveCommand}" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="0,0,8,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="268" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Capa -->
        <StackPanel Grid.Column="0" Margin="0,0,28,0">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr 'Capa'}" />
            <Grid Width="240" Height="240">
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource DiscTemplate}" />
                <Border CornerRadius="10">
                    <Border.Background>
                        <ImageBrush Stretch="UniformToFill"
                                    ImageSource="{Binding CoverPreview, Converter={StaticResource CoverImage}}" />
                    </Border.Background>
                </Border>
            </Grid>
            <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Text="{l:Tr 'Arraste uma imagem ou um link para esta janela, escolha um arquivo ou busque online.'}" />
            <Button Margin="0,12,0,0" Content="{l:Tr 'Escolher capa…'}" Command="{Binding ChooseCoverCommand}" />
            <Button Margin="0,6,0,0" Content="{l:Tr '▣  Buscar capa online'}" Command="{Binding FetchCoverCommand}" />
            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,16,0,5" Text="{l:Tr 'Ou cole o link de uma imagem'}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="UrlBox" Grid.Column="0" Padding="9,8" FontSize="12"
                         ToolTip="{l:Tr 'Ex.: clique com o botão direito numa imagem do Google e escolha &quot;Copiar endereço da imagem&quot;'}"
                         Text="{Binding ImageUrl, UpdateSourceTrigger=PropertyChanged}"
                         PreviewKeyDown="OnUrlKeyDown" />
                <Button Grid.Column="1" Margin="6,0,0,0" Padding="12,8" Content="{l:Tr 'Baixar'}"
                        Command="{Binding DownloadFromUrlCommand}" />
            </Grid>
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center" FontSize="12" MinHeight="16"
                       Foreground="{DynamicResource AccentBrush}" Text="{Binding CoverStatus}" />
            <Button Margin="0,6,0,0" Style="{StaticResource GhostButton}" Content="{l:Tr 'Remover capa'}"
                    Command="{Binding RemoveCoverCommand}" />
        </StackPanel>

        <!-- Campos -->
        <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding WindowTitle}" FontSize="22" FontWeight="Bold" Margin="0,0,0,18" />

            <Grid>
                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr 'Álbum'}" />
                <TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                           Text="{l:Tr 'digite o nome e clique em Buscar dados'}" />
            </Grid>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TitleBox" Grid.Column="0"
                         Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                         PreviewKeyDown="OnTitleKeyDown" />
                <Button Grid.Column="1" Margin="6,0,0,0" Padding="14,8" Style="{StaticResource PrimaryButton}"
                        Content="{l:Tr '⌕  Buscar dados'}" Command="{Binding LookupAlbumCommand}"
                        ToolTip="{l:Tr 'Busca o artista e a data de lançamento na internet'}" />
            </Grid>
            <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" FontSize="12" MinHeight="16"
                       Foreground="{DynamicResource AccentBrush}" Text="{Binding LookupStatus}" />

            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr 'Artista'}" />
            <TextBox Margin="0,0,0,12" Text="{Binding Artist, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr 'Mídia'}" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <RadioButton Style="{StaticResource ChipRadio}" GroupName="Format" Content="{l:Tr '♫  Vinil'}" Margin="0,0,8,0"
                             IsChecked="{Binding Format, Converter={StaticResource EnumToBool}, ConverterParameter=Vinyl}" />
                <RadioButton Style="{StaticResource ChipRadio}" GroupName="Format" Content="{l:Tr '◉  CD'}" Margin="0,0,8,0"
                             IsChecked="{Binding Format, Converter={StaticResource EnumToBool}, ConverterParameter=CD}" />
                <RadioButton Style="{StaticResource ChipRadio}" GroupName="Format" Content="{l:Tr '▤  Cassete'}"
                             IsChecked="{Binding Format, Converter={StaticResource EnumToBool}, ConverterParameter=Cassette}" />
            </StackPanel>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr 'Lançamento'}" />
                    <TextBox ToolTip="{l:Tr 'dd/mm/aaaa ou só o ano'}"
                             Text="{Binding ReleaseDateText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0"
                            Visibility="{Binding ShowPurchaseYear, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr 'Ano de compra'}" />
                    <TextBox Text="{Binding PurchaseYearText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding PriceLabel}" />
                    <TextBox ToolTip="{l:Tr 'Exemplo: 45,90'}" Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>

            <!-- ===== Gênero e listas ===== -->
            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr 'Gênero'}" />
            <TextBox Text="{Binding Genre, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{l:Tr 'Ex.: Rock, MPB, Jazz… ou escolha uma sugestão abaixo'}" />
            <ItemsControl Margin="-2,6,0,10" ItemsSource="{Binding GenreSuggestions}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource GhostButton}" Padding="9,3" FontSize="12" Margin="0,0,2,2"
                                Content="{Binding}" CommandParameter="{Binding}"
                                Command="{Binding DataContext.PickGenreCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr 'Listas'}" />
            <ItemsControl ItemsSource="{Binding TagChoices}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ToggleButton Style="{StaticResource ChipToggle}" Margin="0,0,6,6"
                                      Content="{Binding Display}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="NewTagBox" Grid.Column="0" Padding="9,7" FontSize="12"
                         ToolTip="{l:Tr 'Digite o nome de uma lista nova (ex.: Jantar, Viagem) e aperte Enter'}"
                         Text="{Binding NewTagText, UpdateSourceTrigger=PropertyChanged}"
                         PreviewKeyDown="OnNewTagKeyDown" />
                <Button Grid.Column="1" Margin="6,0,0,0" Padding="12,7" Content="{l:Tr '+  Criar lista'}"
                        Command="{Binding AddTagCommand}" />
            </Grid>

            <!-- ===== Nota, local e conservação (só para o que já foi comprado) ===== -->
            <StackPanel Visibility="{Binding ShowCollectionFields, Converter={StaticResource BoolToVisibility}}">
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr 'Minha nota'}" />
                        <ItemsControl ItemsSource="{Binding Stars}"
                                      ToolTip="{l:Tr 'Clique numa estrela para dar a nota; clique de novo para tirar'}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource StarButton}" Content="{Binding Glyph}"
                                            CommandParameter="{Binding Number}"
                                            Command="{Binding DataContext.SetRatingCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr 'Onde comprou'}" />
                        <TextBox ToolTip="{l:Tr 'Loja, feira, site, presente…'}"
                                 Text="{Binding PurchasePlace, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <Grid>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr 'Conservação do disco / fita / CD'}" />
                    <TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource AccentBrush}"
                               Text="{Binding MediaConditionLabel}" />
                </Grid>
                <ItemsControl Margin="0,0,0,8" ItemsSource="{Binding MediaConditions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource MiniChip}" GroupName="MediaCondition" Margin="0,0,5,5"
                                         Content="{Binding Label}" ToolTip="{Binding ToolTip}"
                                         IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr 'Conservação da capa / encarte'}" />
                    <TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource AccentBrush}"
                               Text="{Binding CoverConditionLabel}" />
                </Grid>
                <ItemsControl Margin="0,0,0,12" ItemsSource="{Binding CoverConditions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource MiniChip}" GroupName="CoverCondition" Margin="0,0,5,5"
                                         Content="{Binding Label}" ToolTip="{Binding ToolTip}"
                                         IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr 'Observações'}" />
            <TextBox Height="70" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto"
                     Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
    </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
