<Window x:Class="ColecaoMidias.Views.AlbumEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="800" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        AllowDrop="True" Drop="OnDrop"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}" FontSize="13">
    <Grid Margin="28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="268" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Capa -->
        <StackPanel Grid.Column="0" Margin="0,0,28,0">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Capa" />
            <Grid Width="240" Height="240">
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource DiscTemplate}" />
                <Border CornerRadius="10">
                    <Border.Background>
                        <ImageBrush Stretch="UniformToFill"
                                    ImageSource="{Binding CoverPreview, Converter={StaticResource CoverImage}}" />
                    </Border.Background>
                </Border>
            </Grid>
            <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Text="Arraste uma imagem ou um link para esta janela, escolha um arquivo ou busque online." />
            <Button Margin="0,12,0,0" Content="Escolher capa…" Command="{Binding ChooseCoverCommand}" />
            <Button Margin="0,6,0,0" Content="▣  Buscar capa online" Command="{Binding FetchCoverCommand}" />
            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,16,0,5" Text="Ou cole o link de uma imagem" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="UrlBox" Grid.Column="0" Padding="9,8" FontSize="12"
                         ToolTip="Ex.: clique com o botão direito numa imagem do Google e escolha &quot;Copiar endereço da imagem&quot;"
                         Text="{Binding ImageUrl, UpdateSourceTrigger=PropertyChanged}"
                         PreviewKeyDown="OnUrlKeyDown" />
                <Button Grid.Column="1" Margin="6,0,0,0" Padding="12,8" Content="Baixar"
                        Command="{Binding DownloadFromUrlCommand}" />
            </Grid>
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center" FontSize="12" MinHeight="16"
                       Foreground="{DynamicResource AccentBrush}" Text="{Binding CoverStatus}" />
            <Button Margin="0,6,0,0" Style="{StaticResource GhostButton}" Content="Remover capa"
                    Command="{Binding RemoveCoverCommand}" />
        </StackPanel>

        <!-- Campos -->
        <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding WindowTitle}" FontSize="22" FontWeight="Bold" Margin="0,0,0,18" />

            <Grid>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Álbum" />
                <TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                           Text="digite o nome e clique em Buscar dados" />
            </Grid>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TitleBox" Grid.Column="0"
                         Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                         PreviewKeyDown="OnTitleKeyDown" />
                <Button Grid.Column="1" Margin="6,0,0,0" Padding="14,8" Style="{StaticResource PrimaryButton}"
                        Content="⌕  Buscar dados" Command="{Binding LookupAlbumCommand}"
                        ToolTip="Busca o artista e a data de lançamento na internet" />
            </Grid>
            <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" FontSize="12" MinHeight="16"
                       Foreground="{DynamicResource AccentBrush}" Text="{Binding LookupStatus}" />

            <TextBlock Style="{StaticResource FieldLabel}" Text="Artista" />
            <TextBox Margin="0,0,0,12" Text="{Binding Artist, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Style="{StaticResource FieldLabel}" Text="Mídia" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <RadioButton Style="{StaticResource ChipRadio}" GroupName="Format" Content="♫  Vinil" Margin="0,0,8,0"
                             IsChecked="{Binding Format, Converter={StaticResource EnumToBool}, ConverterParameter=Vinyl}" />
                <RadioButton Style="{StaticResource ChipRadio}" GroupName="Format" Content="◉  CD" Margin="0,0,8,0"
                             IsChecked="{Binding Format, Converter={StaticResource EnumToBool}, ConverterParameter=CD}" />
                <RadioButton Style="{StaticResource ChipRadio}" GroupName="Format" Content="▤  Cassete"
                             IsChecked="{Binding Format, Converter={StaticResource EnumToBool}, ConverterParameter=Cassette}" />
            </StackPanel>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Lançamento" />
                    <TextBox ToolTip="dd/mm/aaaa ou só o ano"
                             Text="{Binding ReleaseDateText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0"
                            Visibility="{Binding ShowPurchaseYear, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Ano de compra" />
                    <TextBox Text="{Binding PurchaseYearText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding PriceLabel}" />
                    <TextBox ToolTip="Exemplo: 45,90" Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>

            <TextBlock Style="{StaticResource FieldLabel}" Text="Observações" />
            <TextBox Height="76" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto"
                     Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" MinHeight="18"
                       Foreground="{DynamicResource ErrorBrush}" Text="{Binding ErrorMessage}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Cancelar" Style="{StaticResource GhostButton}" Margin="0,0,8,0" IsCancel="True" />
                <Button Content="Salvar" Style="{StaticResource PrimaryButton}" Padding="26,9" IsDefault="True"
                        Command="{Binding SaveCommand}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
