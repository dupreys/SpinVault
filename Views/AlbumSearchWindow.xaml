<Window x:Class="ColecaoMidias.Views.AlbumSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Escolha o álbum"
        Width="560" Height="480" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}" FontSize="13">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Qual é o seu álbum?" FontSize="22" FontWeight="Bold" />
            <TextBlock Margin="0,4,0,14" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="Encontrei mais de um resultado. Dê dois cliques no correto ou selecione e clique em Usar este." />
        </StackPanel>

        <ListBox x:Name="ResultList" Grid.Row="1" ItemsSource="{Binding}"
                 Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                 BorderThickness="1" HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseDoubleClick="OnDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="6,6">
                        <TextBlock Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,2,0,0" FontSize="12" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding Subtitle, Mode=OneWay}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" Style="{StaticResource GhostButton}" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="Usar este" Style="{StaticResource PrimaryButton}" Padding="26,9" IsDefault="True"
                    Click="OnUse" />
        </StackPanel>
    </Grid>
</Window>
