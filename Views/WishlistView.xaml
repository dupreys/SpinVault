<UserControl x:Class="ColecaoMidias.Views.WishlistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ColecaoMidias.Services"
             Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,20" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="{l:Tr 'Lista de desejos'}" FontSize="32" FontWeight="Bold" />
                <TextBlock Margin="0,2,0,0" Text="{Binding SummaryText}" FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center"
                    Content="{l:Tr '+  Adicionar desejo'}" Command="{Binding AddCommand}" />
        </DockPanel>

        <Grid Grid.Row="1">
            <!-- Lista vazia -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="♡" FontSize="64" HorizontalAlignment="Center" Foreground="{DynamicResource LineBrush}" />
                <TextBlock Text="{l:Tr 'Sua lista de desejos está vazia'}" FontSize="20" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,8,0,0" />
                <TextBlock TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,18"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{l:Tr 'Anote os discos, CDs e fitas que você quer comprar, com o preço que pretende pagar. Quando comprar, é só clicar em &quot;Comprei!&quot; e o álbum vai para a coleção.'}" />
                <Button Style="{StaticResource PrimaryButton}" Content="{l:Tr '+  Adicionar desejo'}" HorizontalAlignment="Center"
                        Command="{Binding AddCommand}" />
            </StackPanel>

            <Grid Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ListBox Foreground="{DynamicResource TextPrimaryBrush}" Grid.Column="0" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         ItemTemplate="{StaticResource AlbumCardTemplate}"
                         ItemContainerStyle="{StaticResource CardItem}"
                         Background="Transparent" BorderThickness="0" Padding="0" Margin="-8,0,0,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Margin="8,10,8,8" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.InputBindings>
                        <MouseBinding Gesture="LeftDoubleClick" Command="{Binding EditCommand}" />
                    </ListBox.InputBindings>
                </ListBox>

                <!-- Detalhes -->
                <Border x:Name="DetailsPanel" Grid.Column="1" Width="300" Margin="18,0,0,0" Padding="18" CornerRadius="20"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                    <Grid>
                        <StackPanel VerticalAlignment="Center"
                                    Visibility="{Binding NoSelection, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="♡" FontSize="54" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource LineBrush}" />
                            <TextBlock Text="{l:Tr 'Selecione um item para ver os detalhes.'}" TextWrapping="Wrap"
                                       TextAlignment="Center" Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>

                        <DockPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Content="{l:Tr '✓  Comprei!'}" Padding="22,9"
                                        Command="{Binding BoughtCommand}" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="{l:Tr 'Editar'}" Padding="22,8" Margin="0,0,8,0" Command="{Binding EditCommand}" />
                                    <Button Style="{StaticResource GhostButton}" Content="{l:Tr 'Remover'}"
                                            Foreground="{DynamicResource ErrorBrush}" Command="{Binding DeleteCommand}" />
                                </StackPanel>
                            </StackPanel>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <ContentControl Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}" MaxHeight="262" Content="{Binding SelectedItem}"
                                                    ContentTemplate="{StaticResource CoverTemplate}" />
                                    <TextBlock Margin="0,16,0,0" FontSize="19" FontWeight="Bold" TextWrapping="Wrap"
                                               Text="{Binding SelectedItem.Title}" />
                                    <TextBlock Margin="0,3,0,0" FontSize="14" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="{Binding SelectedItem.Artist}" />
                                    <Border Margin="0,12,0,0" HorizontalAlignment="Left" Padding="10,4" CornerRadius="11"
                                            Background="{DynamicResource SurfaceAltBrush}">
                                        <TextBlock FontWeight="SemiBold" FontSize="12"
                                                   Foreground="{Binding SelectedItem.Format, Converter={StaticResource FormatBrush}}"
                                                   Text="{Binding SelectedItem.FormatDisplay}" />
                                    </Border>
                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr 'Preço-alvo'}" />
                                            <TextBlock FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource AccentBrush}"
                                                       Text="{Binding SelectedItem.PriceDisplay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr 'Lançamento'}" />
                                            <TextBlock FontWeight="SemiBold" Text="{Binding SelectedItem.ReleaseDisplay}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Margin="0,14,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="{Binding SelectedItem.Notes}" />
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
