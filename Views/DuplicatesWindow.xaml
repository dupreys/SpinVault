<Window x:Class="ColecaoMidias.Views.DuplicatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Álbuns repetidos"
        Width="660" Height="580" MinHeight="400" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}" FontSize="13">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Álbuns repetidos" FontSize="22" FontWeight="Bold" />
            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="{Binding SummaryText}" />
            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                       Text="O mesmo álbum em vinil e em CD costuma ser proposital. Exclua só o que for cadastro duplicado." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,8,12" Padding="14" CornerRadius="12"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentBrush}" Text="{Binding Kind, Mode=OneWay}" />
                                    <TextBlock FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis"
                                               Text="{Binding Title, Mode=OneWay}" />
                                </DockPanel>
                                <TextBlock Margin="0,2,0,8" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{Binding Artist, Mode=OneWay}" />
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" FontWeight="SemiBold" VerticalAlignment="Center"
                                                           Foreground="{Binding Format, Converter={StaticResource FormatBrush}}"
                                                           Text="{Binding FormatDisplay, Mode=OneWay}" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Text="{Binding SummaryLine, Mode=OneWay}" />
                                                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Padding="10,4" Content="Excluir"
                                                        Foreground="{DynamicResource ErrorBrush}"
                                                        Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="2" Margin="0,12,0,0" HorizontalAlignment="Right" Padding="26,9" Content="Fechar" IsCancel="True" IsDefault="True" />
    </Grid>
</Window>
