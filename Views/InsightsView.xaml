<UserControl x:Class="ColecaoMidias.Views.InsightsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ColecaoMidias.Services"
             Foreground="{DynamicResource TextPrimaryBrush}"
             SizeChanged="OnSizeChanged">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="18" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!-- Linha de ranking: rótulo, barra e valor -->
        <DataTemplate x:Key="BarRow">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" MinWidth="86" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" />
                <ProgressBar Grid.Column="1" Style="{StaticResource BarProgress}" Height="7" Margin="8,0"
                             Minimum="0" Maximum="{Binding Max, Mode=OneWay}" Value="{Binding Value, Mode=OneWay}" />
                <TextBlock Grid.Column="2" Text="{Binding Display}" FontWeight="SemiBold" FontSize="12"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,10,0">
            <!-- Cabeçalho -->
            <DockPanel Margin="0,0,0,14">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ShareButton" Content="{l:Tr '⇪  Compartilhar'}" Padding="18,9" Click="OnShareClick"
                            ToolTip="{l:Tr 'Salvar um resumo da coleção como imagem ou PDF'}" />
                    <Popup x:Name="SharePopup" PlacementTarget="{Binding ElementName=ShareButton}" Placement="Bottom"
                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" HorizontalOffset="-110" VerticalOffset="6">
                        <Border Margin="0,0,14,14" Padding="6" CornerRadius="14" Width="270"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.35" />
                            </Border.Effect>
                            <StackPanel>
                                <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left"
                                        Content="{l:Tr '🖼  Imagem (PNG) para redes sociais'}"
                                        Command="{Binding ExportImageCommand}" Click="OnShareItemClick" />
                                <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left"
                                        Content="{l:Tr '📄  Relatório em PDF'}"
                                        Command="{Binding ExportPdfCommand}" Click="OnShareItemClick" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{l:Tr 'Resumo'}" FontSize="28" FontWeight="Bold" />
                    <TextBlock Margin="0,1,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{l:Tr 'Valor da coleção, rankings e aniversários de lançamento'}" />
                </StackPanel>
            </DockPanel>

            <!-- Indicadores -->
            <UniformGrid x:Name="KpiGrid" Columns="3" Margin="0,0,0,12">
                <Border Style="{StaticResource Card}" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="{l:Tr 'VALOR INVESTIDO'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Margin="0,4,0,0" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                   Text="{Binding TotalValueText}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0">
                    <StackPanel>
                        <TextBlock Text="{l:Tr 'ITENS NA COLEÇÃO'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Margin="0,4,0,0" FontSize="26" FontWeight="Bold" Text="{Binding ItemsText}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="{l:Tr 'TICKET MÉDIO'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Margin="0,4,0,0" FontSize="26" FontWeight="Bold" Text="{Binding AverageText}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Este mês há X anos -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{Binding AnniversaryTitle}" TextTrimming="CharacterEllipsis" />
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding AnniversaryHint}"
                               Visibility="{Binding HasNoAnniversaries, Converter={StaticResource BoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Anniversaries}"
                                  Visibility="{Binding HasAnniversaries, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="9" Background="{DynamicResource SurfaceAltBrush}"
                                            HorizontalAlignment="Left">
                                        <Grid>
                                            <TextBlock Text="♫" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                            <Border CornerRadius="9">
                                                <Border.Background>
                                                    <ImageBrush Stretch="UniformToFill" ImageSource="{Binding Album.CoverImage}" />
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,0,0">
                                        <TextBlock HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Text="{Binding YearsText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRound}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock HorizontalAlignment="Right" FontSize="11" Text="{Binding DayText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,5" FontSize="12"
                            Foreground="{DynamicResource AccentBrush}" Content="{Binding MoreText}"
                            ToolTip="{l:Tr 'Abrir a lista completa deste mês'}"
                            Command="{Binding ShowAllAnniversariesCommand}"
                            Visibility="{Binding HasMoreAnniversaries, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- Valor da coleção: por ano, por mídia e por artista -->
            <UniformGrid x:Name="SpendGrid" Columns="3" Margin="0,0,0,12">
                <Border Style="{StaticResource Card}" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:Tr 'Gasto por ano de compra'}" />
                        <ItemsControl ItemsSource="{Binding SpendByYear}" ItemTemplate="{StaticResource BarRow}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:Tr 'Gasto por mídia'}" />
                        <ItemsControl ItemsSource="{Binding SpendByMedia}" ItemTemplate="{StaticResource BarRow}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:Tr 'Onde mais gastei — artistas'}" />
                        <ItemsControl ItemsSource="{Binding SpendByArtist}" ItemTemplate="{StaticResource BarRow}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Ranking por quantidade -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{l:Tr 'Artistas com mais álbuns'}" />
                    <ItemsControl ItemsSource="{Binding TopArtists}" ItemTemplate="{StaticResource BarRow}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
