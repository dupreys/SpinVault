<UserControl x:Class="ColecaoMidias.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextPrimaryBrush}"
             SizeChanged="OnSizeChanged">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="16" />
            <Style.Triggers>
                <!-- Ao passar o mouse o contorno acende em âmbar -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="KpiIcon" TargetType="Border">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="KpiIconText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style x:Key="KpiLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style x:Key="KpiValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <!-- Botão sem aparência: só a área do conteúdo recebe o clique (fatias da rosca, pontos do gráfico) -->
        <Style x:Key="FlatHit" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter x:Name="Cp" />
                        <ControlTemplate.Triggers>
                            <!-- Brilho suave ao passar o mouse -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cp" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#FFFFFF" BlurRadius="14" ShadowDepth="0" Opacity="0.55" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Linha clicável (ranking, legenda): realça ao passar o mouse -->
        <Style x:Key="RowHit" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="10"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Etiqueta de filtro ativo -->
        <Style x:Key="FilterChipButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{DynamicResource AccentSoftBrush}"
                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                CornerRadius="15" Padding="13,5" Margin="0,0,8,6">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Linha do ranking de artistas (clique filtra pelo artista) -->
        <DataTemplate x:Key="BarTemplate">
            <Button Opacity="{Binding Dim}" Margin="0,1"
                    Command="{Binding DataContext.ToggleArtistCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding Label}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource RowHit}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="28" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Label}" TextTrimming="CharacterEllipsis" FontSize="12"
                               ToolTip="{Binding Label}" VerticalAlignment="Center" />
                    <ProgressBar Grid.Column="1" Style="{StaticResource BarProgress}" Height="7" Margin="8,0"
                                 Minimum="0" Maximum="{Binding Max, Mode=OneWay}" Value="{Binding Value, Mode=OneWay}" />
                    <TextBlock Grid.Column="2" Text="{Binding Display}" FontWeight="SemiBold"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Button>
        </DataTemplate>

        <!-- Itens posicionados dentro do gráfico de linha (Canvas) -->
        <Style x:Key="DotContainer" TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding DotLeft}" />
            <Setter Property="Canvas.Top" Value="{Binding DotTop}" />
        </Style>
        <Style x:Key="ValueContainer" TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding ValueLeft}" />
            <Setter Property="Canvas.Top" Value="{Binding ValueTop}" />
        </Style>
        <Style x:Key="LabelContainer" TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding LabelLeft}" />
            <Setter Property="Canvas.Top" Value="{Binding LabelTop}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,10,0">
            <!-- Cabeçalho -->
            <DockPanel Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" VerticalAlignment="Center" Content="✕  Limpar filtros"
                        Command="{Binding ClearFiltersCommand}"
                        Visibility="{Binding HasFilters, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel>
                    <TextBlock Text="Dashboard" FontSize="28" FontWeight="Bold" />
                    <TextBlock Margin="0,1,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}">
                        <Run Text="Mostrando:" />
                        <Run Text="{Binding ScopeText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </TextBlock>
                </StackPanel>
            </DockPanel>

            <!-- Filtros ativos / dica -->
            <Grid Margin="0,0,0,8">
                <ItemsControl ItemsSource="{Binding ActiveFilters}"
                              Visibility="{Binding HasFilters, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource FilterChipButton}" ToolTip="Clique para remover este filtro"
                                    Command="{Binding DataContext.RemoveFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Text}" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="  ✕" FontSize="10" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                           Text="Dica: clique em um ano, formato ou artista para filtrar todo o painel. Clique de novo para remover."
                           Visibility="{Binding HasFilters, Converter={StaticResource InverseBoolToVisibility}}" />
            </Grid>

            <!-- Indicadores -->
            <UniformGrid x:Name="KpiGrid" Columns="4">
                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource KpiIcon}">
                            <TextBlock Style="{StaticResource KpiIconText}" Text="♫" />
                        </Border>
                        <StackPanel>
                            <TextBlock Style="{StaticResource KpiLabel}" Text="Total de itens" />
                            <TextBlock Style="{StaticResource KpiValue}" Text="{Binding TotalItems}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource KpiIcon}">
                            <TextBlock Style="{StaticResource KpiIconText}" Text="R$" FontSize="11" />
                        </Border>
                        <StackPanel>
                            <TextBlock Style="{StaticResource KpiLabel}" Text="Valor" />
                            <TextBlock Style="{StaticResource KpiValue}" Text="{Binding TotalValueText}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource KpiIcon}">
                            <TextBlock Style="{StaticResource KpiIconText}" Text="≈" FontSize="16" />
                        </Border>
                        <StackPanel>
                            <TextBlock Style="{StaticResource KpiLabel}" Text="Ticket médio" />
                            <TextBlock Style="{StaticResource KpiValue}" Text="{Binding AverageTicketText}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource KpiIcon}">
                            <TextBlock Style="{StaticResource KpiIconText}" Text="★" />
                        </Border>
                        <StackPanel>
                            <TextBlock Style="{StaticResource KpiLabel}" Text="Álbum mais caro" />
                            <TextBlock Margin="0,2,0,0" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                       Text="{Binding MostExpensiveTitle}" ToolTip="{Binding MostExpensiveTitle}" />
                            <TextBlock FontSize="11" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" Text="{Binding MostExpensiveDetail}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </UniformGrid>

            <!-- Destaques / álbuns do filtro: faixa de capas logo abaixo dos indicadores -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16,12,16,6">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Right" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}" Text="{Binding MoreText}" />
                        <StackPanel Orientation="Horizontal">
                            <Border Width="22" Height="22" CornerRadius="7" Background="{DynamicResource AccentGradientBrush}" Margin="0,0,9,0">
                                <TextBlock Text="★" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentForegroundBrush}" />
                            </Border>
                            <TextBlock FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Text="{Binding AlbumsTitle}" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Margin="0,0,0,10" Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Nenhum álbum com essa combinação de filtros."
                               Visibility="{Binding HasAlbums, Converter={StaticResource InverseBoolToVisibility}}" />
                    <ScrollViewer x:Name="StripScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="OnStripWheel">
                        <ItemsControl ItemsSource="{Binding Matches}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Capa cresce levemente ao passar o mouse -->
                                    <Border Margin="0,4,12,10" Cursor="Hand" ToolTip="{Binding SummaryLine}"
                                            Background="Transparent" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1" />
                                        </Border.RenderTransform>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.07" Duration="0:0:0.14" />
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.07" Duration="0:0:0.14" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.18" />
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.18" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Width="96">
                                            <ContentControl Height="96" Content="{Binding}" ContentTemplate="{StaticResource CoverTemplate}" />
                                            <TextBlock Margin="2,6,2,0" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding Title}" />
                                            <TextBlock Margin="2,0,2,0" FontSize="10" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Artist}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- Formato · artistas · aquisições (lado a lado; empilham em janelas estreitas) -->
            <Grid x:Name="ChartsGrid" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1.5*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="FormatCard" Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Formato" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Viewbox Width="136" Height="136">
                                <Grid Width="220" Height="220">
                                    <ItemsControl ItemsSource="{Binding Formats}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Grid />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource FlatHit}" Opacity="{Binding Dim}" ToolTip="{Binding Tip}"
                                                        Command="{Binding DataContext.ToggleFormatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Format}">
                                                    <Path Data="{Binding Data}"
                                                          Fill="{Binding Format, Converter={StaticResource FormatBrush}}" />
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock Text="{Binding TotalItems}" FontSize="40" FontWeight="Bold"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="itens" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Viewbox>

                            <ItemsControl Margin="14,0,0,0" VerticalAlignment="Center" ItemsSource="{Binding Formats}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Opacity="{Binding Dim}" Margin="0,1" Padding="8,4"
                                                Command="{Binding DataContext.ToggleFormatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Format}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource RowHit}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                                         Fill="{Binding Format, Converter={StaticResource FormatBrush}}" />
                                                <StackPanel Margin="9,0,0,0">
                                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12" />
                                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                                        <Run Text="{Binding Count, Mode=OneWay}" /><Run Text=" itens · " /><Run Text="{Binding PercentText, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="ArtistCard" Grid.Row="0" Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Artistas" />
                        <ItemsControl ItemsSource="{Binding TopArtists}" ItemTemplate="{StaticResource BarTemplate}" />
                    </StackPanel>
                </Border>

                <Border x:Name="YearCard" Grid.Row="0" Grid.Column="4" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Aquisições por ano" />
                        <Viewbox Stretch="Uniform" MaxHeight="190" HorizontalAlignment="Center">
                            <Grid Width="460" Height="210">
                                <Rectangle Height="1" Width="400" Margin="30,168,0,0" HorizontalAlignment="Left"
                                           VerticalAlignment="Top" Fill="{DynamicResource LineBrush}" />

                                <Path Data="{Binding YearArea}">
                                    <Path.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#55F59E0B" Offset="0" />
                                            <GradientStop Color="#00F59E0B" Offset="1" />
                                        </LinearGradientBrush>
                                    </Path.Fill>
                                </Path>
                                <Path Data="{Binding YearLine}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="3"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />

                                <!-- Pontos -->
                                <ItemsControl ItemsSource="{Binding YearPoints}" ItemContainerStyle="{StaticResource DotContainer}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource FlatHit}" Opacity="{Binding Dim}" ToolTip="{Binding Tip}"
                                                    Command="{Binding DataContext.ToggleYearCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Label}">
                                                <Grid Width="26" Height="26" Background="Transparent">
                                                    <Ellipse Width="12" Height="12" StrokeThickness="3"
                                                             Stroke="{DynamicResource AccentBrush}">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="{DynamicResource SurfaceBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                                                        <Setter Property="Width" Value="16" />
                                                                        <Setter Property="Height" Value="16" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Valores acima dos pontos -->
                                <ItemsControl ItemsSource="{Binding YearPoints}" ItemContainerStyle="{StaticResource ValueContainer}"
                                              IsHitTestVisible="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Width="40" TextAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       Opacity="{Binding Dim}" Text="{Binding ValueText}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Anos embaixo -->
                                <ItemsControl ItemsSource="{Binding YearPoints}" ItemContainerStyle="{StaticResource LabelContainer}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource FlatHit}" Opacity="{Binding Dim}" ToolTip="{Binding Tip}"
                                                    Command="{Binding DataContext.ToggleYearCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Label}">
                                                <Border Width="40" Padding="0,4" Background="Transparent" CornerRadius="8">
                                                    <TextBlock TextAlignment="Center" FontSize="12" Text="{Binding Label}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                                        <Setter Property="FontWeight" Value="Bold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Viewbox>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
