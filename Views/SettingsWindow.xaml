<Window x:Class="ColecaoMidias.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurações"
        Width="620" Height="680" MinHeight="420" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}" FontSize="13">
    <DockPanel Margin="28,24,28,22">
        <Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,16,0,0"
                Style="{StaticResource PrimaryButton}" Content="Fechar" Click="OnClose" />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Configurações" FontSize="22" FontWeight="Bold" />
                <TextBlock Margin="0,4,0,18" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding VersionText}" />

                <!-- ===== Backup automático ===== -->
                <Border Padding="18" CornerRadius="14" Margin="0,0,0,16"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                    <StackPanel>
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ChipToggle}" VerticalAlignment="Center"
                                          IsChecked="{Binding AutoBackupEnabled, Mode=TwoWay}" Content="Ativado" />
                            <TextBlock Text="Backup automático" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="O SpinVault guarda uma cópia da coleção (banco de dados e capas) de tempos em tempos, só quando algo mudou, e apaga as mais antigas." />

                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,16,0,6" Text="COM QUE FREQUÊNCIA" />
                        <ItemsControl ItemsSource="{Binding IntervalOptions}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource MiniChip}" GroupName="BackupInterval" Margin="0,0,6,6"
                                                 Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,10,0,6" Text="QUANTOS BACKUPS MANTER" />
                        <ItemsControl ItemsSource="{Binding KeepOptions}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource MiniChip}" GroupName="BackupKeep" Margin="0,0,6,6"
                                                 Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                   Text="Só os backups automáticos são apagados; backups que você salvou manualmente não são tocados." />

                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,16,0,6" Text="PASTA DOS BACKUPS" />
                        <TextBox IsReadOnly="True" Padding="9,8" FontSize="12" Text="{Binding FolderText, Mode=OneWay}" />
                        <TextBlock Margin="0,6,0,8" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}"
                                   Text="{Binding FolderHint}" />
                        <WrapPanel>
                            <Button Style="{StaticResource GhostButton}" Margin="0,0,8,6" Content="Escolher pasta…" Command="{Binding ChooseFolderCommand}" />
                            <Button Style="{StaticResource GhostButton}" Margin="0,0,8,6" Content="Abrir pasta" Command="{Binding OpenFolderCommand}" />
                            <Button Style="{StaticResource GhostButton}" Margin="0,0,8,6" Content="Usar a pasta padrão" Command="{Binding UseDefaultFolderCommand}"
                                    Visibility="{Binding UsingCustomFolder, Converter={StaticResource BoolToVisibility}}" />
                        </WrapPanel>

                        <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,10,0,14" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Padding="14,7" VerticalAlignment="Center"
                                    Content="Fazer backup agora" Command="{Binding BackupNowCommand}" />
                            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" Text="{Binding LastBackupText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LastBackupFailed}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DockPanel>
                        <TextBlock Margin="0,10,0,0" FontSize="11" Foreground="{DynamicResource AccentBrush}"
                                   Text="Fazendo o backup…" Visibility="{Binding IsBackingUp, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- ===== Atualizações ===== -->
                <Border Padding="18" CornerRadius="14"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                    <StackPanel>
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ChipToggle}" VerticalAlignment="Center"
                                          IsChecked="{Binding UpdateCheckEnabled, Mode=TwoWay}" Content="Ativado" />
                            <TextBlock Text="Avisar sobre novas versões" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Margin="0,6,0,14" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="Uma vez por dia o SpinVault pergunta ao GitHub se existe uma versão nova. Nada é instalado sozinho: você só recebe o aviso e o link para baixar." />
                        <WrapPanel>
                            <Button Style="{StaticResource GhostButton}" Margin="0,0,8,6" Content="Verificar agora" Command="{Binding CheckUpdatesCommand}" />
                            <Button Style="{StaticResource PrimaryButton}" Padding="14,7" Margin="0,0,8,6" Content="Baixar a nova versão" Command="{Binding DownloadUpdateCommand}"
                                    Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}" />
                        </WrapPanel>
                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding UpdateText}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
