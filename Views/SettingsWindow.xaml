<Window x:Class="ColecaoMidias.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ColecaoMidias.Services"
        Title="{l:Tr 'Configurações'}"
        Width="620" Height="680" MinHeight="420" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}" FontSize="13">
    <DockPanel Margin="28,24,28,22">
        <Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,16,0,0"
                Style="{StaticResource PrimaryButton}" Content="{l:Tr 'Fechar'}" Click="OnClose" />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="{l:Tr 'Configurações'}" FontSize="22" FontWeight="Bold" />
                <TextBlock Margin="0,4,0,18" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding VersionText}" />

                <!-- ===== Idioma / Language ===== -->
                <Border Padding="18" CornerRadius="14" Margin="0,0,0,16"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Idioma / Language" FontSize="16" FontWeight="Bold" />
                        <TextBlock Margin="0,6,0,12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{l:Tr 'Escolha o idioma do SpinVault. O app reinicia para aplicar a mudança.'}" />
                        <ItemsControl ItemsSource="{Binding LanguageOptions}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource MiniChip}" GroupName="AppLanguage" Margin="0,0,6,6"
                                                 Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ===== Sincronização entre aparelhos ===== -->
                <Border Padding="18" CornerRadius="14" Margin="0,0,0,16"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{l:Tr 'Sincronização entre aparelhos'}" FontSize="16" FontWeight="Bold" />
                        <TextBlock Margin="0,6,0,12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{l:Tr 'Escolha uma pasta do OneDrive, Google Drive ou Dropbox. O SpinVault guarda a coleção nela e o serviço de nuvem leva para os outros aparelhos (o Android escolhe a mesma pasta). Não precisa de conta no SpinVault.'}" />
                        <TextBlock TextWrapping="Wrap" Text="{Binding SyncFolderText}" />
                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                   Text="{Binding SyncStatusText}" />
                        <WrapPanel Margin="0,12,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Padding="14,7" Margin="0,0,8,6" Content="{l:Tr 'Escolher pasta…'}" Command="{Binding ChooseSyncFolderCommand}" />
                            <Button Style="{StaticResource GhostButton}" Margin="0,0,8,6" Content="{l:Tr 'Sincronizar agora'}" Command="{Binding SyncNowCommand}"
                                    Visibility="{Binding SyncEnabled, Converter={StaticResource BoolToVisibility}}" />
                            <Button Style="{StaticResource GhostButton}" Margin="0,0,8,6" Content="{l:Tr 'Abrir pasta'}" Command="{Binding OpenSyncFolderCommand}"
                                    Visibility="{Binding SyncEnabled, Converter={StaticResource BoolToVisibility}}" />
                            <Button Style="{StaticResource GhostButton}" Margin="0,0,8,6" Content="{l:Tr 'Parar de sincronizar'}" Command="{Binding StopSyncCommand}"
                                    Visibility="{Binding SyncEnabled, Converter={StaticResource BoolToVisibility}}" />
                        </WrapPanel>
                        <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource AccentBrush}"
                                   Text="{l:Tr 'Sincronizando…'}" Visibility="{Binding IsSyncing, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- ===== Backup automático ===== -->
                <Border Padding="18" CornerRadius="14" Margin="0,0,0,16"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                    <StackPanel>
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ChipToggle}" VerticalAlignment="Center"
                                          IsChecked="{Binding AutoBackupEnabled, Mode=TwoWay}" Content="{l:Tr 'Ativado'}" />
                            <TextBlock Text="{l:Tr 'Backup automático'}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{l:Tr 'O SpinVault guarda uma cópia da coleção (banco de dados e capas) de tempos em tempos, só quando algo mudou, e apaga as mais antigas.'}" />

                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,16,0,6" Text="{l:Tr 'COM QUE FREQUÊNCIA'}" />
                        <ItemsControl ItemsSource="{Binding IntervalOptions}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource MiniChip}" GroupName="BackupInterval" Margin="0,0,6,6"
                                                 Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,10,0,6" Text="{l:Tr 'QUANTOS BACKUPS MANTER'}" />
                        <ItemsControl ItemsSource="{Binding KeepOptions}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource MiniChip}" GroupName="BackupKeep" Margin="0,0,6,6"
                                                 Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                   Text="{l:Tr 'Só os backups automáticos são apagados; backups que você salvou manualmente não são tocados.'}" />

                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,16,0,6" Text="{l:Tr 'PASTA DOS BACKUPS'}" />
                        <TextBox IsReadOnly="True" Padding="9,8" FontSize="12" Text="{Binding FolderText, Mode=OneWay}" />
                        <TextBlock Margin="0,6,0,8" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}"
                                   Text="{Binding FolderHint}" />
                        <WrapPanel>
                            <Button Style="{StaticResource GhostButton}" Margin="0,0,8,6" Content="{l:Tr 'Escolher pasta…'}" Command="{Binding ChooseFolderCommand}" />
                            <Button Style="{StaticResource GhostButton}" Margin="0,0,8,6" Content="{l:Tr 'Abrir pasta'}" Command="{Binding OpenFolderCommand}" />
                            <Button Style="{StaticResource GhostButton}" Margin="0,0,8,6" Content="{l:Tr 'Usar a pasta padrão'}" Command="{Binding UseDefaultFolderCommand}"
                                    Visibility="{Binding UsingCustomFolder, Converter={StaticResource BoolToVisibility}}" />
                        </WrapPanel>

                        <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,10,0,14" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Padding="14,7" VerticalAlignment="Center"
                                    Content="{l:Tr 'Fazer backup agora'}" Command="{Binding BackupNowCommand}" />
                            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" Text="{Binding LastBackupText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LastBackupFailed}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DockPanel>
                        <TextBlock Margin="0,10,0,0" FontSize="11" Foreground="{DynamicResource AccentBrush}"
                                   Text="{l:Tr 'Fazendo o backup…'}" Visibility="{Binding IsBackingUp, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- ===== Atualizações ===== -->
                <Border Padding="18" CornerRadius="14"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                    <StackPanel>
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ChipToggle}" VerticalAlignment="Center"
                                          IsChecked="{Binding UpdateCheckEnabled, Mode=TwoWay}" Content="{l:Tr 'Ativado'}" />
                            <TextBlock Text="{l:Tr 'Avisar sobre novas versões'}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Margin="0,6,0,14" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{l:Tr 'Uma vez por dia o SpinVault pergunta ao GitHub se existe uma versão nova. Nada é instalado sozinho: você só recebe o aviso e o link para baixar.'}" />
                        <WrapPanel>
                            <Button Style="{StaticResource GhostButton}" Margin="0,0,8,6" Content="{l:Tr 'Verificar agora'}" Command="{Binding CheckUpdatesCommand}" />
                            <Button Style="{StaticResource PrimaryButton}" Padding="14,7" Margin="0,0,8,6" Content="{l:Tr 'Baixar a nova versão'}" Command="{Binding DownloadUpdateCommand}"
                                    Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}" />
                        </WrapPanel>
                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding UpdateText}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
