<Window x:Class="ColecaoMidias.Views.MetadataBatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Completar dados"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}" FontSize="13">
    <StackPanel Margin="28">
        <TextBlock Text="Completar dados" FontSize="22" FontWeight="Bold" />
        <TextBlock Margin="0,4,0,20" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="Buscando a data de lançamento dos álbuns na internet (MusicBrainz). Só preenche quando tem certeza." />

        <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Margin="0,3,0,12" MinHeight="18" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding CurrentItem}" />

        <ProgressBar Style="{StaticResource BarProgress}" Height="12" Minimum="0"
                     Maximum="{Binding Total, Mode=OneWay}" Value="{Binding Done, Mode=OneWay}" />

        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}">
                <Run Text="{Binding Found, Mode=OneWay}" />
                <Run Text="completados" />
            </TextBlock>
            <TextBlock Margin="22,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}">
                <Run Text="{Binding Missing, Mode=OneWay}" />
                <Run Text="sem data" />
            </TextBlock>
        </StackPanel>

        <Button Margin="0,22,0,0" HorizontalAlignment="Right" Padding="26,9"
                Content="{Binding CloseButtonText}" Click="OnButtonClick" />
    </StackPanel>
</Window>
