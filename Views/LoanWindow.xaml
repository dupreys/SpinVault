<Window x:Class="ColecaoMidias.Views.LoanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ColecaoMidias.Services"
        Title="{l:Tr 'Emprestar disco'}"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}" FontSize="13">
    <StackPanel Margin="28,24,28,22">
        <TextBlock Text="{l:Tr 'Emprestar disco'}" FontSize="20" FontWeight="Bold" />
        <TextBlock x:Name="AlbumText" Margin="0,4,0,18" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr 'PARA QUEM'}" />
        <TextBox x:Name="NameBox" Padding="9,8" MaxLength="80" />
        <StackPanel x:Name="SuggestionsPanel" Margin="0,8,0,0">
            <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Text="{l:Tr 'Já emprestou para:'}" Margin="0,0,0,4" />
            <ItemsControl x:Name="Suggestions">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource GhostButton}" Padding="10,4" FontSize="12" Margin="0,0,6,6"
                                Foreground="{DynamicResource AccentBrush}" Content="{Binding}" Click="OnSuggestionClick" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,0" Text="{l:Tr 'EMPRESTADO EM'}" />
        <TextBox x:Name="DateBox" Padding="9,8" Width="160" HorizontalAlignment="Left" />

        <TextBlock x:Name="Error" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Style="{StaticResource GhostButton}" Content="{l:Tr 'Cancelar'}" Margin="0,0,8,0" IsCancel="True" Click="OnCancel" />
            <Button Style="{StaticResource PrimaryButton}" Content="{l:Tr 'Emprestar'}" IsDefault="True" Click="OnSave" />
        </StackPanel>
    </StackPanel>
</Window>
