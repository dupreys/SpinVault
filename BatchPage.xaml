<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="SpinVaultMobile.BatchPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             BackgroundColor="{StaticResource Bg}"
             Shell.NavBarIsVisible="False">

    <VerticalStackLayout Padding="20,40,20,20" Spacing="16" VerticalOptions="Center">
        <Label Text="{Binding Title}" Style="{StaticResource TitleLabel}" />
        <Label Text="{Binding StatusText}" FontSize="16" />
        <ProgressBar Progress="{Binding Progress}" ProgressColor="{StaticResource Accent}" />
        <Label Text="{Binding CurrentItem}" FontSize="13" TextColor="{StaticResource TextSecondary}" MaxLines="2" LineBreakMode="TailTruncation" />
        <Label FontSize="13" TextColor="{StaticResource TextMuted}">
            <Label.Text>
                <MultiBinding StringFormat="{}{0} / {1}">
                    <Binding Path="Done" />
                    <Binding Path="Total" />
                </MultiBinding>
            </Label.Text>
        </Label>
        <Button Text="{Binding CloseButtonText}" Style="{StaticResource PrimaryButton}" Clicked="OnCloseClicked" />
    </VerticalStackLayout>
</ContentPage>
