<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="SpinVaultMobile.AlbumDetailPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:l="clr-namespace:SpinVaultMobile"
             BackgroundColor="{StaticResource Bg}"
             Title="{Binding Album.Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">
            <Border Style="{StaticResource Card}" Padding="0" HeightRequest="320" HorizontalOptions="Fill">
                <Grid BackgroundColor="{StaticResource SurfaceAlt}">
                    <Label Text="♫" FontSize="80" TextColor="{StaticResource TextMuted}"
                           HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding Album.NoCover}" />
                    <Image Source="{Binding Album.CoverPath}" Aspect="AspectFit" IsVisible="{Binding Album.HasCover}" />
                </Grid>
            </Border>

            <VerticalStackLayout Spacing="2">
                <Label Text="{Binding Album.Title}" FontSize="24" FontAttributes="Bold" />
                <Label Text="{Binding Album.Artist}" FontSize="16" TextColor="{StaticResource TextSecondary}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rows}" Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="120,*" ColumnSpacing="10">
                                <Label Text="{Binding Label}" FontSize="13" TextColor="{StaticResource TextMuted}" />
                                <Label Grid.Column="1" Text="{Binding Value}" FontSize="14" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>

            <Button Text="{l:Tr 'Comprei!'}" Style="{StaticResource PrimaryButton}"
                    IsVisible="{Binding IsWishlist}" Clicked="OnBoughtClicked" />
            <Button Text="{Binding FavoriteText}" Style="{StaticResource GhostButton}"
                    IsVisible="{Binding IsNotWishlist}" Clicked="OnFavoriteClicked" />
            <Button Text="{l:Tr 'Editar'}" Style="{StaticResource PrimaryButton}" Clicked="OnEditClicked" />
            <Button Text="{l:Tr 'Excluir'}" Style="{StaticResource GhostButton}"
                    TextColor="{StaticResource Danger}" Clicked="OnDeleteClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
