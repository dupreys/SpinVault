<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>SpinVaultMobile</RootNamespace>
    <AssemblyName>SpinVaultMobile</AssemblyName>
    <UseMaui>true</UseMaui>
    <SuppressTrimAnalyzerWarnings>true</SuppressTrimAnalyzerWarnings>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>SpinVault</ApplicationTitle>
    <ApplicationId>com.spinvault.app</ApplicationId>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>

    <!-- Os arquivos compartilhados com o app Windows usam este símbolo para deixar de fora o que é só do WPF -->
    <DefineConstants>$(DefineConstants);SPINVAULT_MOBILE</DefineConstants>

    <!-- .apk (instala direto no celular), não .aab (que é só para a Google Play) -->
    <AndroidPackageFormat>apk</AndroidPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.png" Color="#0E1016" />
    <MauiSplashScreen Include="Resources\Splash\splash.png" Color="#0E1016" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.110" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
  </ItemGroup>

  <!-- Código de dados, importação, backup e idioma está em Shared/ (copiado do SpinVault para Windows) e entra no build pelo padrão do SDK. -->

  <ItemGroup>
    <!-- Aviso do SQLite embutido no Microsoft.Data.Sqlite (ainda sem versão corrigida) -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
  </ItemGroup>

</Project>
