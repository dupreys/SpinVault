<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="SpinVaultMobile.CollectionPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:l="clr-namespace:SpinVaultMobile"
             BackgroundColor="{StaticResource Bg}"
             Shell.NavBarIsVisible="False">

    <Grid>
        <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="16,12,16,0" RowSpacing="8">
            <VerticalStackLayout Grid.Row="0" Spacing="2">
                <Label Text="{Binding PageTitle}" Style="{StaticResource TitleLabel}" />
                <Label Text="{Binding Summary}" FontSize="13" TextColor="{StaticResource TextSecondary}" />
            </VerticalStackLayout>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4,0">
                <SearchBar Text="{Binding SearchText}" Placeholder="{l:Tr 'Buscar álbum ou artista…'}" />
            </Border>

            <CollectionView Grid.Row="2" ItemsSource="{Binding Chips}" ItemsLayout="HorizontalList"
                            SelectionMode="None" HeightRequest="46">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,8,0" Padding="16,8" StrokeShape="RoundRectangle 18"
                                StrokeThickness="1" Stroke="{StaticResource Line}"
                                BackgroundColor="{StaticResource Surface}" VerticalOptions="Center">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                                    <Setter Property="Stroke" Value="{StaticResource Accent}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnChipTapped" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding Label}" FontSize="14" TextColor="{StaticResource TextPrimary}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource AccentFg}" />
                                        <Setter Property="FontAttributes" Value="Bold" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <CollectionView x:Name="AlbumList" Grid.Row="3" ItemsSource="{Binding Items}"
                            SelectionMode="Single" SelectionChanged="OnAlbumSelected">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="12" VerticalItemSpacing="12" />
                </CollectionView.ItemsLayout>
                <CollectionView.Footer>
                    <BoxView HeightRequest="90" Color="Transparent" />
                </CollectionView.Footer>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="0" StrokeShape="RoundRectangle 14">
                            <VerticalStackLayout>
                                <Grid HeightRequest="160" BackgroundColor="{StaticResource SurfaceAlt}">
                                    <Label Text="♫" FontSize="44" TextColor="{StaticResource TextMuted}"
                                           HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding NoCover}" />
                                    <Image Source="{Binding CoverPath}" Aspect="AspectFill" IsVisible="{Binding HasCover}" />
                                    <Border BackgroundColor="#B3000000" StrokeThickness="0" StrokeShape="RoundRectangle 8"
                                            Padding="8,3" Margin="8" HorizontalOptions="Start" VerticalOptions="Start">
                                        <Label Text="{Binding FormatDisplay}" FontSize="11" TextColor="White" />
                                    </Border>
                                </Grid>
                                <VerticalStackLayout Padding="10,8,10,10" Spacing="1">
                                    <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="14" MaxLines="1" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Artist}" FontSize="12" TextColor="{StaticResource TextSecondary}" MaxLines="1" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding PriceDisplay}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Accent}" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Grid.Row="3" Text="{Binding EmptyMessage}" IsVisible="{Binding IsEmpty}"
                   TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" VerticalOptions="Center"
                   HorizontalTextAlignment="Center" Margin="24" />
        </Grid>

        <Button Text="+" FontSize="30" Padding="0" WidthRequest="60" HeightRequest="60" CornerRadius="30"
                BackgroundColor="{StaticResource Accent}" TextColor="{StaticResource AccentFg}"
                HorizontalOptions="End" VerticalOptions="End" Margin="0,0,20,20" Clicked="OnAddClicked" />
    </Grid>
</ContentPage>
