<Window Icon="/Assets/app.ico" x:Class="ColecaoMidias.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ColecaoMidias.Views"
        Title="SpinVault — Coleção de Mídias"
        Width="1280" Height="780" MinWidth="1000" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}" FontSize="13">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Menu lateral -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="18,24,18,20">
                <!-- Logo -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,32">
                    <Image Width="44" Height="44" Source="/Assets/logo-128.png"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="SpinVault" FontSize="16" FontWeight="Bold" />
                        <TextBlock Text="Vinis · CDs · Fitas" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Rodapé: tema -->
                <Button DockPanel.Dock="Bottom" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left"
                        Content="{Binding ThemeButtonText}" Command="{Binding ToggleThemeCommand}" />

                <!-- Navegação -->
                <StackPanel>
                    <TextBlock Text="MENU" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,10"
                               Foreground="{DynamicResource TextMutedBrush}" />
                    <RadioButton Style="{StaticResource NavRadio}" GroupName="Nav"
                                 IsChecked="{Binding PageKey, Converter={StaticResource KeyMatch}, ConverterParameter=collection}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="♫" Width="26" FontSize="16" />
                            <TextBlock Text="Coleção" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavRadio}" GroupName="Nav"
                                 IsChecked="{Binding PageKey, Converter={StaticResource KeyMatch}, ConverterParameter=wishlist}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="♡" Width="26" FontSize="16" />
                            <TextBlock Text="Desejos" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavRadio}" GroupName="Nav"
                                 IsChecked="{Binding PageKey, Converter={StaticResource KeyMatch}, ConverterParameter=dashboard}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◔" Width="26" FontSize="16" />
                            <TextBlock Text="Dashboard" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Brilho ambiente (canto superior direito) -->
        <Border Grid.Column="1" IsHitTestVisible="False" Background="{DynamicResource AmbientGlowBrush}" />

        <!-- Conteúdo da página atual -->
        <Grid Grid.Column="1" Margin="32,26,32,24">
            <!-- Página "collection": fica sempre montada; só alterna a visibilidade (troca instantânea) -->
            <Grid>
                <Grid.RenderTransform>
                    <TranslateTransform />
                </Grid.RenderTransform>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PageKey, Converter={StaticResource KeyMatch}, ConverterParameter=collection}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource PageEnter}" />
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <views:CollectionView DataContext="{Binding Collection}" />
            </Grid>
            <!-- Página "wishlist" -->
            <Grid>
                <Grid.RenderTransform>
                    <TranslateTransform />
                </Grid.RenderTransform>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PageKey, Converter={StaticResource KeyMatch}, ConverterParameter=wishlist}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource PageEnter}" />
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <views:WishlistView DataContext="{Binding Wishlist}" />
            </Grid>
            <!-- Página "dashboard": fica sempre montada; só alterna a visibilidade (troca instantânea) -->
            <Grid>
                <Grid.RenderTransform>
                    <TranslateTransform />
                </Grid.RenderTransform>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PageKey, Converter={StaticResource KeyMatch}, ConverterParameter=dashboard}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource PageEnter}" />
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <views:DashboardView DataContext="{Binding Dashboard}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
