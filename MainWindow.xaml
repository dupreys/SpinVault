<Window Icon="/Assets/app.ico" x:Class="ColecaoMidias.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ColecaoMidias.Services"
        xmlns:views="clr-namespace:ColecaoMidias.Views"
        Title="{l:Tr 'SpinVault — Coleção de Mídias'}"
        Width="1280" Height="780" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}" FontSize="13">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Menu lateral -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel x:Name="SidebarPanel" Margin="18,24,18,20">
                <!-- Logo -->
                <StackPanel x:Name="LogoPanel" DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,32">
                    <Image Width="44" Height="44" Source="/Assets/logo-128.png"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding IsCompact, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="{l:Tr 'SpinVault'}" FontSize="16" FontWeight="Bold" />
                        <TextBlock Text="{l:Tr 'Vinis · CDs · Fitas'}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Rodapé: tema -->
                <Button DockPanel.Dock="Bottom" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left"
                        ToolTip="{Binding ThemeButtonText}" Command="{Binding ToggleThemeCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ThemeButtonIcon}" Width="26" />
                        <TextBlock Text="{Binding ThemeButtonText}"
                                   Visibility="{Binding IsCompact, Converter={StaticResource InverseBoolToVisibility}}" />
                    </StackPanel>
                </Button>

                <Button DockPanel.Dock="Bottom" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,0,0,4"
                        ToolTip="{l:Tr 'Configurações'}" Command="{Binding OpenSettingsCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚙" Width="26" />
                        <TextBlock Text="{l:Tr 'Configurações'}"
                                   Visibility="{Binding IsCompact, Converter={StaticResource InverseBoolToVisibility}}" />
                    </StackPanel>
                </Button>

                <!-- Navegação -->
                <StackPanel>
                    <TextBlock Text="{l:Tr 'MENU'}" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,10"
                               Visibility="{Binding IsCompact, Converter={StaticResource InverseBoolToVisibility}}"
                               Foreground="{DynamicResource TextMutedBrush}" />
                    <RadioButton Style="{StaticResource NavRadio}" GroupName="Nav" ToolTip="{l:Tr 'Coleção'}"
                                 IsChecked="{Binding PageKey, Converter={StaticResource KeyMatch}, ConverterParameter=collection}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="♫" Width="26" FontSize="16" />
                            <TextBlock Text="{l:Tr 'Coleção'}" Visibility="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibility}}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavRadio}" GroupName="Nav" ToolTip="{l:Tr 'Desejos'}"
                                 IsChecked="{Binding PageKey, Converter={StaticResource KeyMatch}, ConverterParameter=wishlist}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="♡" Width="26" FontSize="16" />
                            <TextBlock Text="{l:Tr 'Desejos'}" Visibility="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibility}}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavRadio}" GroupName="Nav" ToolTip="{l:Tr 'Dashboard'}"
                                 IsChecked="{Binding PageKey, Converter={StaticResource KeyMatch}, ConverterParameter=dashboard}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◔" Width="26" FontSize="16" />
                            <TextBlock Text="{l:Tr 'Dashboard'}" Visibility="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibility}}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavRadio}" GroupName="Nav" ToolTip="{l:Tr 'Resumo'}"
                                 IsChecked="{Binding PageKey, Converter={StaticResource KeyMatch}, ConverterParameter=insights}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◈" Width="26" FontSize="16" />
                            <TextBlock Text="{l:Tr 'Resumo'}" Visibility="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibility}}" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Brilho ambiente (canto superior direito) -->
        <Border Grid.Column="1" IsHitTestVisible="False" Background="{DynamicResource AmbientGlowBrush}" />

        <!-- Conteúdo da página atual -->
        <Grid x:Name="ContentGrid" Grid.Column="1" Margin="32,26,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Aviso de nova versão -->
            <Border Grid.Row="0" Margin="0,0,0,16" Padding="16,10" CornerRadius="12"
                    Background="{DynamicResource AccentSoftBrush}"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                    Visibility="{Binding UpdateBannerVisible, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="12,5" Margin="8,0,0,0"
                            Content="{l:Tr 'Agora não'}" Command="{Binding SkipUpdateCommand}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Padding="14,6"
                            Content="{l:Tr 'Baixar'}" Command="{Binding DownloadUpdateCommand}" />
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" Text="{Binding UpdateBannerText}" />
                </DockPanel>
            </Border>

            <Grid Grid.Row="1">
            <!-- Página "collection": fica sempre montada; só alterna a visibilidade (troca instantânea) -->
            <Grid>
                <Grid.RenderTransform>
                    <TranslateTransform />
                </Grid.RenderTransform>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PageKey, Converter={StaticResource KeyMatch}, ConverterParameter=collection}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource PageEnter}" />
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <views:CollectionView DataContext="{Binding Collection}" />
            </Grid>
            <!-- Página "wishlist" -->
            <Grid>
                <Grid.RenderTransform>
                    <TranslateTransform />
                </Grid.RenderTransform>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PageKey, Converter={StaticResource KeyMatch}, ConverterParameter=wishlist}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource PageEnter}" />
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <views:WishlistView DataContext="{Binding Wishlist}" />
            </Grid>
            <!-- Página "dashboard": fica sempre montada; só alterna a visibilidade (troca instantânea) -->
            <Grid>
                <Grid.RenderTransform>
                    <TranslateTransform />
                </Grid.RenderTransform>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PageKey, Converter={StaticResource KeyMatch}, ConverterParameter=dashboard}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource PageEnter}" />
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <views:DashboardView DataContext="{Binding Dashboard}" />
            </Grid>
            <!-- Página "insights" (Resumo) -->
            <Grid>
                <Grid.RenderTransform>
                    <TranslateTransform />
                </Grid.RenderTransform>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PageKey, Converter={StaticResource KeyMatch}, ConverterParameter=insights}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource PageEnter}" />
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <views:InsightsView DataContext="{Binding Insights}" />
            </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
