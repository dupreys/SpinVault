<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Tema escuro: grafite profundo com acento âmbar (luz de vitrola).
         As chaves precisam ser as mesmas do LightTheme.xaml. -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0E1016" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#0A0C11" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#161922" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#1E2230" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#282D3F" />
    <SolidColorBrush x:Key="LineBrush" Color="#2A3042" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F5F9" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9EA6BB" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#6C7490" />

    <SolidColorBrush x:Key="AccentBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2AF59E0B" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#1B1203" />
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FBBF24" Offset="0" />
        <GradientStop Color="#F97316" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ErrorBrush" Color="#F87171" />

    <!-- Brilho ambiente no canto da área de conteúdo e fundo das etiquetas sobre as capas -->
    <RadialGradientBrush x:Key="AmbientGlowBrush" Center="0.9,0" GradientOrigin="0.9,0" RadiusX="0.75" RadiusY="0.55">
        <GradientStop Color="#2BF59E0B" Offset="0" />
        <GradientStop Color="#00F59E0B" Offset="1" />
    </RadialGradientBrush>
    <SolidColorBrush x:Key="BadgeGlassBrush" Color="#B3000000" />

    <SolidColorBrush x:Key="DiscBodyBrush" Color="#0B0C10" />
    <SolidColorBrush x:Key="DiscGrooveBrush" Color="#2A2E3B" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#3A4157" />

    <!-- Cores das mídias (iguais nos dois temas) -->
    <SolidColorBrush x:Key="VinylBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="CdBrush" Color="#2FA8F0" />
    <SolidColorBrush x:Key="CassetteBrush" Color="#A863F0" />
</ResourceDictionary>
