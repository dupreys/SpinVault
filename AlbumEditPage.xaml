<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="SpinVaultMobile.AlbumEditPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:l="clr-namespace:SpinVaultMobile"
             BackgroundColor="{StaticResource Bg}"
             Title="{Binding PageTitle}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">
            <Border Style="{StaticResource Card}" Padding="0" HeightRequest="220">
                <Grid BackgroundColor="{StaticResource SurfaceAlt}">
                    <Label Text="♫" FontSize="64" TextColor="{StaticResource TextMuted}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                    <Image Source="{Binding CoverPath}" Aspect="AspectFit" IsVisible="{Binding HasCover}" />
                </Grid>
            </Border>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Text="{l:Tr 'Escolher capa…'}" Style="{StaticResource GhostButton}" Clicked="OnPickCoverClicked" />
                <Button Grid.Column="1" Text="{l:Tr 'Buscar capa online'}" Style="{StaticResource GhostButton}" Clicked="OnFetchCoverClicked" />
            </Grid>
            <Button Text="{l:Tr 'Remover capa'}" Style="{StaticResource GhostButton}" HeightRequest="40"
                    IsVisible="{Binding HasCover}" Clicked="OnRemoveCoverClicked" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="0">
                    <Label Text="{l:Tr 'Álbum'}" Style="{StaticResource SectionLabel}" />
                    <Entry Text="{Binding Title}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="0">
                    <Label Text="{l:Tr 'Artista'}" Style="{StaticResource SectionLabel}" />
                    <Entry Text="{Binding Artist}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="{l:Tr 'Buscar dados'}" Style="{StaticResource GhostButton}" HeightRequest="40" Clicked="OnLookupClicked" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="0">
                    <Label Text="{l:Tr 'Mídia'}" Style="{StaticResource SectionLabel}" />
                    <Picker ItemsSource="{Binding FormatLabels}" SelectedIndex="{Binding FormatIndex}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="0">
                    <Label Text="{l:Tr 'Lançamento'}" Style="{StaticResource SectionLabel}" />
                    <Entry Text="{Binding ReleaseDateText}" Placeholder="{l:Tr 'dd/mm/aaaa ou só o ano'}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="0">
                    <Label Text="{Binding PriceLabel}" Style="{StaticResource SectionLabel}" />
                    <Entry Text="{Binding PriceText}" Placeholder="{l:Tr 'Exemplo: 45,90'}" Keyboard="Numeric" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource Card}" IsVisible="{Binding IsNotWishlist}">
                <VerticalStackLayout Spacing="0">
                    <Label Text="{l:Tr 'Ano de compra'}" Style="{StaticResource SectionLabel}" />
                    <Entry Text="{Binding PurchaseYearText}" Keyboard="Numeric" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="0">
                    <Label Text="{l:Tr 'Gênero'}" Style="{StaticResource SectionLabel}" />
                    <Entry Text="{Binding Genre}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="0">
                    <Label Text="{l:Tr 'Minha nota'}" Style="{StaticResource SectionLabel}" />
                    <Picker ItemsSource="{Binding RatingLabels}" SelectedIndex="{Binding RatingIndex}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="0">
                    <Label Text="{l:Tr 'Local de compra'}" Style="{StaticResource SectionLabel}" />
                    <Entry Text="{Binding PurchasePlace}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="0">
                    <Label Text="{l:Tr 'Observações'}" Style="{StaticResource SectionLabel}" />
                    <Editor Text="{Binding Notes}" AutoSize="TextChanges" MinimumHeightRequest="80" />
                </VerticalStackLayout>
            </Border>


            <Label Text="{Binding StatusText}" TextColor="{StaticResource Accent}" FontSize="13" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Accent}" />

            <Button Text="{l:Tr 'Salvar'}" Style="{StaticResource PrimaryButton}" Clicked="OnSaveClicked" />
            <Button Text="{l:Tr 'Cancelar'}" Style="{StaticResource GhostButton}" Clicked="OnCancelClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
